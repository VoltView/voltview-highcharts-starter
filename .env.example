# VoltView API Configuration
# Get your API key from https://app.voltview.co.uk

VOLTVIEW_API_URL=https://api.voltview.co.uk
VOLTVIEW_API_KEY=your-api-key-here

# Optional: If /v1/requestToken requires id and email in the request body
# VOLTVIEW_USER_ID=your-user-id
# VOLTVIEW_USER_EMAIL=your-email@example.com
